; Mango OFFICE — External SIP Trunk (IP peer), mirror of prod /etc/asterisk/pjsip.conf
; PDF: host 81.88.86.55:5060, Register=false. LK: our IP:5060, AON on Routing tab.

[global]
type=global
user_agent=Quantum-AI

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
external_media_address=45.147.178.172
external_signaling_address=45.147.178.172

[mango-trunk-aor]
type=aor
contact=sip:81.88.86.55:5060
qualify_frequency=60

[mango-trunk]
type=endpoint
transport=transport-udp
context=from-mango
disallow=all
allow=alaw
aors=mango-trunk-aor
identify_by=ip
from_user=79699665899
from_domain=81.88.86.55
contact_user=trunk
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=rfc4733
trust_id_inbound=yes
send_pai=no
send_rpid=no

[mango-trunk-identify]
type=identify
endpoint=mango-trunk
match=81.88.86.0/24,81.88.87.0/24,137.74.16.0/24

[ava-test-aor]
type=aor
max_contacts=1
remove_existing=yes

[ava-test]
type=endpoint
context=from-mango
disallow=all
allow=ulaw
transport=transport-udp
direct_media=no
aors=ava-test-aor

[ava-test-identify]
type=identify
endpoint=ava-test
match=127.0.0.1/32
