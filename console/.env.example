# Quantum Labs control console (ops UI for AVA stack)
CONSOLE_TOKEN=
API_HOST=127.0.0.1
API_PORT=8013

# Paths on polyhub (override if relocated)
AVA_ROOT=/root/ava
AVA_ENV_PATH=/root/ava/.env
AVA_CONFIG_PATH=/root/ava/config/ai-agent.local.yaml
KNOWLEDGE_PATH=/root/ava/config/knowledge/quantum_labs.md
CALL_HISTORY_DB=/root/ava/data/call_history.db
MAILER_ENV_PATH=/opt/ava-mailer/.env
MAILER_HEALTH_URL=http://127.0.0.1:8000/health
ENGINE_HEALTH_URL=http://127.0.0.1:15000/health
TEXT_BOT_HEALTH_URL=http://127.0.0.1:8011/health
OUTREACH_HEALTH_URL=http://127.0.0.1:8012/health
BACKUP_SCRIPT=/root/ava/scripts/backup_quantum_labs.sh

# Outbound one-shot dial defaults
OUTBOUND_ENABLED=true
OUTBOUND_DIAL_CONTEXT=from-internal
OUTBOUND_CALLER_ID_NUM=79699665899
OUTBOUND_CALLER_ID_NAME=Quantum Labs
OUTBOUND_STASIS_APP=asterisk-ai-voice-agent
OUTBOUND_AI_CONTEXT=outbound
# Separate Realtime provider from inbound (openai_realtime) — do not share
OUTBOUND_AI_PROVIDER=openai_realtime_outbound
INBOUND_AI_PROVIDER=openai_realtime
KNOWLEDGE_RELOAD_URL=http://127.0.0.1:8017/api/knowledge/reload
KNOWLEDGE_HEALTH_URL=http://127.0.0.1:8017/health
CALENDAR_HEALTH_URL=http://127.0.0.1:8014/health
CONFERENCE_HEALTH_URL=http://127.0.0.1:8016/health
FILES_HEALTH_URL=http://127.0.0.1:8015/health

# Inbound auto-answer line (Asterisk AstDB)
INBOUND_LINE_FAMILY=quantum
INBOUND_LINE_KEY=inbound_line

# Mango VPBX API callback (preferred while SIP PSTN blocked on hosting IP)
# Prefer file with mode 600; do not commit real key/salt.
MANGO_API_ENV_PATH=/root/mango-ip-ab-investigation/mango-api.env
# Or inline:
# MANGO_VPBX_API_KEY=
# MANGO_VPBX_API_SALT=
MANGO_CALLBACK_EXTENSION=12

# Channels report / Tilda
# TILDA_WEBHOOK_SECRET=   # else falls back to CONSOLE_TOKEN
# TILDA_METRIKA_COUNTER=  # Yandex Metrika counter id for site visits
# TILDA_METRIKA_TOKEN=    # OAuth token for Metrika API
# TEXT_BOT_SESSIONS_DB=/opt/ava-text-bot/data/sessions.db
# OUTREACH_MODULES_DB=/opt/ava-outreach/data/modules.db
# CONSOLE_DATA_DIR=/opt/quantum-console/data
# CONSOLE_PUBLIC_BASE=https://a.47z.ru/_quantum_console

# Telegram Mini App (today: Metrika + Tilda webhook)
# TELEGRAM_BOT_TOKEN=     # or reads /opt/ava-text-bot/.env
# TEXT_BOT_ENV_PATH=/opt/ava-text-bot/.env
# MINIAPP_ALLOWED_IDS=963782
# MINIAPP_MENU_TEXT=Каналы сегодня
# MINIAPP_INITDATA_MAX_AGE_SEC=86400
