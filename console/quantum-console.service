[Unit]
Description=Quantum Labs Control Console
After=network.target ava-mailer.service
Wants=ava-mailer.service

[Service]
User=root
WorkingDirectory=/opt/quantum-console
EnvironmentFile=/opt/quantum-console/.env
ExecStart=/opt/quantum-console/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8013
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
