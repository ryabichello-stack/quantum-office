WEBHOOK_TOKEN=change-me

# Size limit (Telegram ~50MB practical cap)
FILES_MAX_BYTES=47185920

# local source — comma-separated absolute roots
FILES_LOCAL_ALLOWLIST=/opt/ava-files/assets,/opt/ava-mailer/assets

# github / repo source
FILES_GITHUB_REPO=ryabichello-stack/quantum-office
FILES_GITHUB_REF=main
FILES_GITHUB_TOKEN=

# Yandex Disk
YADISK_TOKEN=

# Mail.ru Cloud WebDAV (Облако Mail.ru)
# Same mailbox app-password as SMTP/CalDAV works. If USER/PASSWORD empty,
# falls back to MAIL_USERNAME / MAIL_PASSWORD (or MAILRU_CALDAV_*).
MAILRU_WEBDAV_URL=https://webdav.cloud.mail.ru
MAILRU_WEBDAV_USER=office@quantumlabs.ru
MAILRU_WEBDAV_PASSWORD=

# Email delivery
MAIL_SMTP_HOST=smtp.mail.ru
MAIL_SMTP_PORT=465
MAIL_USERNAME=office@quantumlabs.ru
MAIL_PASSWORD=
MAIL_FROM_NAME=Quantum Labs

# Telegram delivery
TELEGRAM_BOT_TOKEN=
# Commercial / Business bot (sendDocument with business_connection_id)
TELEGRAM_BUSINESS_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
