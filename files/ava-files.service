[Unit]
Description=Quantum Labs Files (broker: disks/repo → email/Telegram)
After=network.target
# Isolated from Asterisk / AVA docker / Polyhub trading.

[Service]
User=root
WorkingDirectory=/opt/ava-files
EnvironmentFile=/opt/ava-files/.env
ExecStart=/opt/ava-files/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8015
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
