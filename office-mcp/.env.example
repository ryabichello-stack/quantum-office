# Copy to office-mcp/.env on the host (mode 600). Never commit real tokens.

# Remote (Cursor/Grok без доступа к localhost прода) — рекомендуемый режим:
CONSOLE_BASE=https://a.47z.ru/_quantum_console
OUTREACH_BASE=https://a.47z.ru/_ava_outreach
TEXT_BOT_BASE=https://a.47z.ru/_ava_secretary
FILES_BASE=https://a.47z.ru/_ava_files
AVA_KNOWLEDGE_BASE=https://a.47z.ru/_ava_knowledge
CALENDAR_BASE=https://a.47z.ru/_ava_calendar
CONFERENCE_BASE=https://a.47z.ru/_ava_conference
CAMPAIGN_BASE=https://a.47z.ru/_ava_sheets_campaign
# MAILER обычно только внутри сети; снаружи не нужен MCP.
# На самой VM можно вместо HTTPS указать http://127.0.0.1:PORT
MAILER_BASE=http://127.0.0.1:8000

# From /opt/quantum-console/.env
CONSOLE_TOKEN=

# Shared webhook (campaign / calendar / conference / files=Mail.ru / text-bot)
WEBHOOK_TOKEN=
# REQUIRED for outreach.* tools — must match /opt/ava-outreach/.env OUTREACH_UI_TOKEN
# (WEBHOOK_TOKEN is a different secret on prod and causes 401 if used alone)
OUTREACH_UI_TOKEN=
OUTREACH_TOKEN=

# Second Brain ACL headers
BRAIN_MCP_PRINCIPAL=service:cursor-admin
BRAIN_MCP_ADMIN=true
BRAIN_MCP_USER_ID=cursor-mcp
BRAIN_TENANT_ID=quantum-labs
