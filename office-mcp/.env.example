# Copy to office-mcp/.env on the host (mode 600). Never commit real tokens.

CONSOLE_BASE=http://127.0.0.1:8013
CAMPAIGN_BASE=http://127.0.0.1:8018
AVA_KNOWLEDGE_BASE=http://127.0.0.1:8017
CALENDAR_BASE=http://127.0.0.1:8014
OUTREACH_BASE=http://127.0.0.1:8012
CONFERENCE_BASE=http://127.0.0.1:8016
FILES_BASE=http://127.0.0.1:8015
TEXT_BOT_BASE=http://127.0.0.1:8011
MAILER_BASE=http://127.0.0.1:8000

# From /opt/quantum-console/.env
CONSOLE_TOKEN=

# Shared webhook (campaign / calendar / conference / files=Mail.ru / text-bot)
WEBHOOK_TOKEN=
# Outreach UI token if different from WEBHOOK_TOKEN
OUTREACH_UI_TOKEN=
OUTREACH_TOKEN=

# Second Brain ACL headers
BRAIN_MCP_PRINCIPAL=service:office-mcp
BRAIN_MCP_ADMIN=true
BRAIN_MCP_USER_ID=office-mcp
BRAIN_TENANT_ID=quantum-labs
