# From /opt/quantum-console/.env
CONSOLE_TOKEN=

# Shared webhook token (sheets-campaign / calendar / outreach UI token)
WEBHOOK_TOKEN=

# Second Brain ACL headers
BRAIN_MCP_PRINCIPAL=service:office-mcp
BRAIN_MCP_ADMIN=true
BRAIN_MCP_USER_ID=office-mcp
BRAIN_TENANT_ID=quantum-labs
