[Unit]
Description=Quantum Labs AVA Text Bot (Telegram)
After=network.target ava-mailer.service
Wants=ava-mailer.service

[Service]
User=root
WorkingDirectory=/opt/ava-text-bot
EnvironmentFile=/opt/ava-text-bot/.env
ExecStart=/opt/ava-text-bot/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8011
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
