# Quantum Labs — Telegram text secretary (AVA shared brain)
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AVA_MAILER_BASE=http://127.0.0.1:8000
AVA_CONFIG_PATH=/root/ava/config/ai-agent.local.yaml
DATA_DIR=/opt/ava-text-bot/data
TELEGRAM_POLL_INTERVAL_SECONDS=1

# Owner chat ids (comma-separated) — who may forward posts to curate bot
SECRETARY_OWNER_IDS=

# ---- Channel curate (forward → rewrite → publish) ----
# Dedicated bot that is admin of the channel (Post messages). Separate from secretary token.
TELEGRAM_CHANNEL_BOT_TOKEN=
TELEGRAM_CURATE_ENABLED=true
TELEGRAM_CURATE_CHANNEL_ID=@epoch_z
TELEGRAM_CURATE_CHANNEL_LINK=https://t.me/epoch_z
TELEGRAM_CURATE_CHANNEL_TITLE=Заметки эпохи
TELEGRAM_CURATE_CONFIRM=false
# Optional: TELEGRAM_CURATE_OWNER_IDS=  (defaults to SECRETARY_OWNER_IDS)
# Optional custom HTML footer: TELEGRAM_CURATE_SIGNATURE=\n\n📣 <a href="https://t.me/epoch_z">Заметки эпохи</a>
