# Quantum Labs — ИИ-секретарь (Telegram + HTTP API + другие каналы)
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AVA_MAILER_BASE=http://127.0.0.1:8000
AVA_KNOWLEDGE_BASE=http://127.0.0.1:8017
# Second Brain (mail/contacts/files) — owner tools on text-bot
BRAIN_ENABLED=true
BRAIN_TENANT_ID=quantum-labs
AVA_CALENDAR_BASE=http://127.0.0.1:8014
AVA_CONFERENCE_BASE=http://127.0.0.1:8016
AVA_FILES_BASE=http://127.0.0.1:8015
# Quantum Console — исходящие звонки / сценарий outbound (owner tools)
AVA_CONSOLE_BASE=http://127.0.0.1:8013
CONSOLE_TOKEN=
CONSOLE_ENABLED=true
OFFICE_WEBHOOK_TOKEN=
AVA_CONFIG_PATH=/root/ava/config/ai-agent.local.yaml
DATA_DIR=/opt/ava-text-bot/data
TELEGRAM_POLL_INTERVAL_SECONDS=1

# Личный секретарь: ваш Telegram user id (из @userinfobot), через запятую
SECRETARY_OWNER_IDS=
# Полный доступ Second Brain — только личный private DM владельца.
# false в проде: гости и группы не получают mail/company.
SECRETARY_TELEGRAM_DEFAULT_OWNER=false
SECRETARY_SCENARIOS_PATH=/opt/ava-text-bot/scenarios.yaml
# Agentic tool loop: keep chaining tools until the task is solved
MAX_TOOL_ROUNDS=14
