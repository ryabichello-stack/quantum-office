# Quantum Labs — Telegram text secretary (AVA shared brain)
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AVA_MAILER_BASE=http://127.0.0.1:8000
AVA_CONFIG_PATH=/root/ava/config/ai-agent.local.yaml
DATA_DIR=/opt/ava-text-bot/data
TELEGRAM_POLL_INTERVAL_SECONDS=1

# Owner chat ids (comma-separated) — who may forward posts to the curate bot
SECRETARY_OWNER_IDS=

# Channel curate (forward → rewrite → publish). Dedicated bot, admin of the channel.
TELEGRAM_CHANNEL_BOT_TOKEN=
TELEGRAM_CURATE_ENABLED=true
TELEGRAM_CURATE_CHANNEL_ID=
TELEGRAM_CURATE_CHANNEL_LINK=
TELEGRAM_CURATE_CHANNEL_TITLE=
TELEGRAM_CURATE_CONFIRM=false
