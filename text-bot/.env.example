# Quantum Labs — Telegram text secretary (AVA shared brain)
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AVA_MAILER_BASE=http://127.0.0.1:8000
AVA_CONFIG_PATH=/root/ava/config/ai-agent.local.yaml
DATA_DIR=/opt/ava-text-bot/data
TELEGRAM_POLL_INTERVAL_SECONDS=1
# HTTP API for MCP /api/chat and /api/messenger/*
WEBHOOK_TOKEN=
# Max messenger outbound (optional)
MAX_ENABLED=false
MAX_BOT_TOKEN=
MAX_BOT_SECRET=
MAX_API_BASE=https://platform-api2.max.ru
