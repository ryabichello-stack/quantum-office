# Quantum Labs — ИИ-секретарь (Telegram + HTTP API + другие каналы)
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AVA_MAILER_BASE=http://127.0.0.1:8000
AVA_KNOWLEDGE_BASE=http://127.0.0.1:8017
# Second Brain (mail/contacts/files) — owner tools on text-bot
BRAIN_ENABLED=true
BRAIN_TENANT_ID=quantum-labs
AVA_CALENDAR_BASE=http://127.0.0.1:8014
AVA_CONFERENCE_BASE=http://127.0.0.1:8016
AVA_FILES_BASE=http://127.0.0.1:8015
# Quantum Console — исходящие звонки / сценарий outbound (owner tools)
AVA_CONSOLE_BASE=http://127.0.0.1:8013
CONSOLE_TOKEN=
CONSOLE_ENABLED=true
OFFICE_WEBHOOK_TOKEN=
AVA_CONFIG_PATH=/root/ava/config/ai-agent.local.yaml
DATA_DIR=/opt/ava-text-bot/data
TELEGRAM_POLL_INTERVAL_SECONDS=1

# Личный секретарь: ваш Telegram user id (из @userinfobot), через запятую
SECRETARY_OWNER_IDS=
# Полный доступ Second Brain — только личный private DM владельца.
# false в проде: гости и группы не получают mail/company.
SECRETARY_TELEGRAM_DEFAULT_OWNER=false
SECRETARY_SCENARIOS_PATH=/opt/ava-text-bot/scenarios.yaml
# Agentic tool loop: keep chaining tools until the task is solved
MAX_TOOL_ROUNDS=14

# ---- Обучение сотрудников (обзвон / продажи) ----
# В боте-консультанте: /обучение <код>
# В режиме trainee — только Knowledge/FAQ, без почты и внутреннего диска.
SECRETARY_TRAINING_ENABLED=true
SECRETARY_TRAINING_PIN=
# Опционально: Telegram user id сотрудников, у кого режим сразу без PIN
SECRETARY_TRAINEE_IDS=

# ---- Messenger channels (guest = Second Brain faq-safe) ----
# Public HTTPS base (nginx): https://a.47z.ru/_ava_secretary/
# Webhooks:
#   WhatsApp  GET/POST  /_ava_secretary/webhooks/whatsapp
#   Max       POST      /_ava_secretary/webhooks/max
#   VK        POST      /_ava_secretary/webhooks/vk

WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

MAX_ENABLED=false
MAX_BOT_TOKEN=
MAX_BOT_SECRET=
MAX_API_BASE=https://platform-api2.max.ru

VK_ENABLED=false
VK_GROUP_TOKEN=
VK_CONFIRMATION_CODE=
VK_SECRET=
VK_GROUP_ID=
VK_API_VERSION=5.199

# ---- Telegram Business (ответы от вашего аккаунта, не от бота) ----
# 1) @BotFather → /mybots → Bot Settings → Business Mode → Enable
# 2) На телефоне: Настройки → Telegram Business → Чат-боты → @Quantum_office_bot
#    права: читать сообщения + отвечать; можно «только новые чаты»
TELEGRAM_BUSINESS_ENABLED=true
TELEGRAM_BUSINESS_AUTO_REPLY=true
# Если вы сами ответили в чате с телефона — автоответ молчит N секунд
TELEGRAM_BUSINESS_OWNER_PAUSE_SECONDS=1800

TELEGRAM_BUSINESS_BOT_TOKEN=

# Voice messages → Whisper STT (same OPENAI_API_KEY)
TELEGRAM_VOICE_STT_ENABLED=true
OPENAI_WHISPER_MODEL=whisper-1

# ---- Owner alerts (важные события → ваш диалог в Telegram + Max) ----
OWNER_ALERT_ENABLED=true
# Telegram chat id (по умолчанию = SECRETARY_OWNER_IDS)
OWNER_ALERT_TELEGRAM_CHAT_ID=
# Ваш user id в Max (диалог с ботом)
OWNER_ALERT_MAX_USER_ID=
OWNER_ALERT_CHANNELS=telegram,max
# HTTP ingest (outreach/mailer/сайт):
#   POST /api/owner-alert
#   POST /api/owner-alert/form   — заявка «заказать звонок»

