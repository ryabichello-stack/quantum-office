[Unit]
Description=Quantum Payouts partner-channel mailer (rdv@, isolated from ava-outreach limits)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/partner-channel
Environment=TZ=Europe/Moscow
Environment=PARTNER_SEND_ENABLED=true
# Secrets loaded by send_campaign.py from /opt/partner-channel/smtp.local.env
ExecStart=/usr/bin/python3 /opt/partner-channel/scripts/send_campaign.py --priority ALL --limit 50
Nice=10
User=root
Group=root

[Install]
WantedBy=multi-user.target
