# Partner channel SMTP — ОТДЕЛЬНЫЙ ящик rdv@quantumlabs.ru
# Не использует office@ и не тратит лимиты ava-outreach (OUTREACH_DAILY_LIMIT).
# Never use office@quantumlabs.ru for this campaign.

MAIL_SMTP_HOST=smtp.mail.ru
MAIL_SMTP_PORT=465
MAIL_USERNAME=rdv@quantumlabs.ru
MAIL_PASSWORD=
MAIL_FROM_NAME=Денис Рябов · Quantum Payouts
MAIL_REPLY_TO=rdv@quantumlabs.ru
MAIL_SMTP_TIMEOUT_SECONDS=20

# Keep false until password is set, then flip to true before send.
PARTNER_SEND_ENABLED=false
