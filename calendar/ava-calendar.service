[Unit]
Description=Quantum Labs Calendar (Mail.ru CalDAV)
After=network.target
# Isolated from Asterisk / AVA docker / Polyhub trading.

[Service]
User=root
WorkingDirectory=/opt/ava-calendar
EnvironmentFile=/opt/ava-calendar/.env
ExecStart=/opt/ava-calendar/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8014
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
