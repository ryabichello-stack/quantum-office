# Quantum Labs — Bitrix CRM outreach (SMTP via Mail.ru office@)
# Copy to .env on prod; never commit secrets.

# Portal (public). Incoming webhook URL is required for sync — ask owner, do not invent.
BITRIX_PORTAL_URL=https://b24-m5614z.bitrix24.ru/
# Full incoming webhook base, e.g. https://b24-m5614z.bitrix24.ru/rest/1/xxxxxxxx/
BITRIX_WEBHOOK_URL=

# SMTP (same Mail.ru office@ as /opt/ava-mailer — copied by install_prod.sh)
MAIL_SMTP_HOST=smtp.mail.ru
MAIL_SMTP_PORT=465
MAIL_USERNAME=office@quantumlabs.ru
MAIL_PASSWORD=
MAIL_FROM_NAME=Quantum Labs
MAIL_REPLY_TO=office@quantumlabs.ru

# Safety: keep false until explicit approval for batch send
OUTREACH_ENABLED=false
OUTREACH_DAILY_LIMIT=15
OUTREACH_DELAY_MIN_SECONDS=60
OUTREACH_DELAY_MAX_SECONDS=180

# Template
OUTREACH_SUBJECT=Сотрудничество — Quantum Labs
OUTREACH_UNSUBSCRIBE_MAILTO=office@quantumlabs.ru
OUTREACH_COMPANY_NAME=Quantum Labs
OUTREACH_WEBSITE=https://quantumlabs.ru
OUTREACH_CONTACT_PHONE=

# After successful SMTP: timeline on COMPANY only (no deal by default).
# Deals are created on reply / telephony qualification / manual.
# Do NOT use crm.activity TYPE=email — Bitrix re-sends mail (IS_MESSAGE_SENT).
BITRIX_CREATE_DEAL=false
BITRIX_ASSIGNED_BY_ID=1
BITRIX_DEAL_STAGE_ID=NEW
BITRIX_TIMELINE_COMMENT=true

# Reply watcher (IMAP office@) — matches From against sent outbox
IMAP_HOST=imap.mail.ru
IMAP_PORT=993
IMAP_MAILBOX=INBOX
REPLY_WATCH_ENABLED=true
REPLY_WATCH_INTERVAL_SECONDS=120
REPLY_BITRIX_EVENT=true
REPLY_NOTIFY_ENABLED=true
REPLY_NOTIFY_EMAIL=office@quantumlabs.ru
# Messenger fan-out (ava-text-bot → ваш Telegram + Max)
OWNER_ALERT_ENABLED=true
OWNER_ALERT_URL=http://127.0.0.1:8011/api/owner-alert
OWNER_ALERT_TOKEN=

# Storage / API
DATA_DIR=/opt/ava-outreach/data
API_HOST=127.0.0.1
API_PORT=8012

# Admin UI token (auto-generated on first start if empty)
OUTREACH_UI_TOKEN=

# Tracking / anti-ban
# Primary chain = Message-ID. Plus Reply-To is optional (Mail.ru may not deliver plus).
TRACKING_PLUS_REPLY_TO=false
TRACKING_HMAC_SECRET=
# Open pixel public base (must match nginx /_ava_outreach/)
OPEN_TRACKING_ENABLED=true
TRACKING_PUBLIC_BASE=https://a.47z.ru/_ava_outreach
# Required for stable HTTPS unsubscribe tokens across restarts — set a long random hex.
WARMUP_ENABLED=true
DOMAIN_DAILY_CAP=2
COMPANY_DAILY_CAP=1
COMPANY_CONTACT_COOLDOWN_DAYS=14
SEQUENCES_ENABLED=true
ONESHOT_DAILY_LIMIT=5

# Primary mailbox protection: keep office@ but pause on bounce spikes.
# Resume via POST /api/modules/deliverability/resume after investigation.

# DaData (party by INN) — API token from https://dadata.ru/
# Secret optional for suggestions findById; required for some cleaner APIs.
DADATA_API_KEY=
DADATA_SECRET_KEY=

# Telephony → Bitrix ingest (ava-mailer fan-out). Same token as mailer WEBHOOK_TOKEN is fine.
TELEPHONY_INGEST_TOKEN=
BITRIX_CALL_DEAL_STAGE_ID=NEW
BITRIX_CALL_COMPANY_INDUSTRY=UC_TM21P2

# Schedule defaults (overridable from UI → settings.db)
SCHEDULE_ENABLED=false
SCHEDULE_WINDOW_START=10
SCHEDULE_WINDOW_END=18
SCHEDULE_TIMEZONE=Europe/Moscow
SCHEDULE_BATCH_SIZE=1
SCHEDULE_TICK_SECONDS=300
