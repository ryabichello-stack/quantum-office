# Quantum Labs — Bitrix CRM outreach (SMTP via Mail.ru office@)
# Copy to .env on prod; never commit secrets.

# Portal (public). Incoming webhook URL is required for sync — ask owner, do not invent.
BITRIX_PORTAL_URL=https://b24-m5614z.bitrix24.ru/
# Full incoming webhook base, e.g. https://b24-m5614z.bitrix24.ru/rest/1/xxxxxxxx/
BITRIX_WEBHOOK_URL=

# SMTP (same Mail.ru office@ as /opt/ava-mailer — copied by install_prod.sh)
MAIL_SMTP_HOST=smtp.mail.ru
MAIL_SMTP_PORT=465
MAIL_USERNAME=office@quantumlabs.ru
MAIL_PASSWORD=
MAIL_FROM_NAME=Quantum Labs
MAIL_REPLY_TO=office@quantumlabs.ru

# Safety: keep false until explicit approval for batch send
OUTREACH_ENABLED=false
OUTREACH_DAILY_LIMIT=15
OUTREACH_DELAY_MIN_SECONDS=60
OUTREACH_DELAY_MAX_SECONDS=180

# Template
OUTREACH_SUBJECT=Сотрудничество — Quantum Labs
OUTREACH_UNSUBSCRIBE_MAILTO=office@quantumlabs.ru
OUTREACH_COMPANY_NAME=Quantum Labs
OUTREACH_WEBSITE=https://quantumlabs.ru
# Active tenant for Studio modules (flywheel, social publish). Default: generic themes.
OUTREACH_TENANT_ID=default
# Quantum Labs prod:
# OUTREACH_TENANT_ID=quantum-labs
OUTREACH_CONTACT_PHONE=

# After successful SMTP: timeline on COMPANY only (no deal by default).
# Deals are created on reply / telephony qualification / manual.
# Do NOT use crm.activity TYPE=email — Bitrix re-sends mail (IS_MESSAGE_SENT).
BITRIX_CREATE_DEAL=false
BITRIX_ASSIGNED_BY_ID=1
BITRIX_DEAL_STAGE_ID=NEW
BITRIX_TIMELINE_COMMENT=true

# Reply watcher (IMAP office@) — matches From against sent outbox
IMAP_HOST=imap.mail.ru
IMAP_PORT=993
IMAP_MAILBOX=INBOX
REPLY_WATCH_ENABLED=true
REPLY_WATCH_INTERVAL_SECONDS=120
REPLY_BITRIX_EVENT=true
REPLY_NOTIFY_ENABLED=true
REPLY_NOTIFY_EMAIL=office@quantumlabs.ru

# Storage / API
DATA_DIR=/opt/ava-outreach/data
API_HOST=127.0.0.1
API_PORT=8012

# Admin UI token (auto-generated on first start if empty)
OUTREACH_UI_TOKEN=
# RBAC (off by default — authenticated = owner). Enable for multi-token roles.
OUTREACH_RBAC_ENABLED=false
OUTREACH_UI_ROLE=owner
# Secondary tokens: role:token pairs (ops|analyst|viewer)
# OUTREACH_ROLE_TOKENS=ops:replace-me,analyst:replace-me

# Owned-page listening → Radar signals (never auto-outreach)
OWNED_LISTEN_ENABLED=false
OWNED_TG_CHANNELS=
OWNED_VK_GROUPS=

# YouTube private upload (Video Studio) — secrets outside git
YOUTUBE_UPLOAD_ENABLED=false
# YOUTUBE_CLIENT_SECRETS=/opt/ava-outreach/secrets/youtube_client.json
# YOUTUBE_TOKEN_PATH=/opt/ava-outreach/secrets/youtube_token.json

# Social publish (TG / VK / Instagram / YouTube community) — APPROVAL_REQUIRED
SOCIAL_PUBLISH_ENABLED=false

# Content Flywheel — parse news → KB → dedup → slots → posts/video
FLYWHEEL_ENABLED=false
FLYWHEEL_SLOTS_PER_DAY=3
FLYWHEEL_SLOT_HOURS=10,14,18
FLYWHEEL_TZ=Europe/Moscow
FLYWHEEL_SOURCE_TG=
FLYWHEEL_SOURCE_VK=
FLYWHEEL_DEDUP_THRESHOLD=0.55
FLYWHEEL_AUTO_KB=true
FLYWHEEL_AVATAR_PROFILE=quantum-host-v1
FLYWHEEL_KB_ENRICH=true
CONTENT_USE_KB=true
# Product/company KB layer on top of thematic brief (optional, default off in flywheel)
FLYWHEEL_USE_PRODUCT_KB=false
# Min relevance 0..1; overrides content_theme.json min_score when set
FLYWHEEL_THEME_MIN_SCORE=0.35
# RSS feeds (comma-separated URLs) — universal for any industry
FLYWHEEL_SOURCE_RSS=
FLYWHEEL_RSS_LIMIT=5
# Optional LLM editorial angle (requires OPENAI_API_KEY)
FLYWHEEL_LLM_ANGLE=false
# Background poll+process cycle (interval in seconds, min 300)
FLYWHEEL_AUTO_CYCLE=false
FLYWHEEL_CYCLE_SECONDS=3600
# Seed: outreach/config/tenants/{tenant_id}/content_theme.json
# Presets: outreach/config/theme_presets/*.json

# Per-platform API tokens wired later (never cold DM)
# Tracking / anti-ban
# Primary chain = Message-ID. Plus Reply-To is optional (Mail.ru may not deliver plus).
TRACKING_PLUS_REPLY_TO=false
TRACKING_HMAC_SECRET=
# Open pixel public base (must match nginx /_ava_outreach/)
OPEN_TRACKING_ENABLED=true
TRACKING_PUBLIC_BASE=https://a.47z.ru/_ava_outreach
# Required for stable HTTPS unsubscribe tokens across restarts — set a long random hex.
WARMUP_ENABLED=true
DOMAIN_DAILY_CAP=2
COMPANY_DAILY_CAP=1
COMPANY_CONTACT_COOLDOWN_DAYS=14
# Sequences / industry packs
SEQUENCES_ENABLED=true
# Active pack id: lombards | mfo | trade_in | gig | scrap
OUTREACH_SEQUENCE_PACK=lombards
# Attach PDF presentation on intro (and pack step 1)
OUTREACH_ATTACH_PRESENTATION=true
# Relative to outreach/assets/ or absolute path
OUTREACH_PRESENTATION_PDF=presentations/lombards.pdf
ONESHOT_DAILY_LIMIT=25

# Primary mailbox protection: keep office@ but pause on bounce spikes.
# Resume via POST /api/modules/deliverability/resume after investigation.

# DaData (party by INN) — API token from https://dadata.ru/
# Secret optional for suggestions findById; required for some cleaner APIs.
DADATA_API_KEY=
DADATA_SECRET_KEY=

# Telephony → Bitrix ingest (ava-mailer fan-out). Same token as mailer WEBHOOK_TOKEN is fine.
TELEPHONY_INGEST_TOKEN=
BITRIX_CALL_DEAL_STAGE_ID=NEW
BITRIX_CALL_COMPANY_INDUSTRY=UC_TM21P2

# Schedule defaults (overridable from UI → settings.db)
SCHEDULE_ENABLED=false
SCHEDULE_WINDOW_START=10
SCHEDULE_WINDOW_END=18
SCHEDULE_TIMEZONE=Europe/Moscow
SCHEDULE_BATCH_SIZE=1
SCHEDULE_TICK_SECONDS=300

# Email CTA «Заказать звонок» → notify + optional AVA dial via Console
CALLBACK_CTA_ENABLED=true
CALLBACK_NOTIFY_ENABLED=true
CALLBACK_DIAL_ENABLED=true
# notify_only | mango_callback | dial  (dial = ARI via Asterisk; mango API often disabled)
CALLBACK_DIAL_MODE=dial
CALLBACK_NOTIFY_EMAIL=
CALLBACK_CTA_TITLE=Если интересно — можем перезвонить
CALLBACK_CTA_BUTTON=Перезвонить
CALLBACK_CTA_LEAD=Оставьте ФИО и телефон — перезвоним в ближайшие минуты.
# Used when CALLBACK_DIAL_MODE=dial
CALLBACK_SCENARIO_GREETING=
CALLBACK_SCENARIO_SCRIPT=
# Console API for auto-dial (same host as quantum-console)
CONSOLE_BASE=http://127.0.0.1:8013
CONSOLE_TOKEN=
