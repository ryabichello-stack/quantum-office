[Unit]
Description=Quantum Labs Second Brain ingest (vault/files/mail)
After=network.target ava-knowledge.service

[Service]
Type=oneshot
WorkingDirectory=/opt/ava-knowledge
EnvironmentFile=-/opt/ava-knowledge/.env
Environment=PYTHONPATH=/opt/ava-knowledge
# Product FAQ SoT = vault shards. Do not re-ingest quantum_labs.md as faq (duplicates vault).
ExecStart=/bin/bash -lc '/opt/ava-knowledge/venv/bin/python -m brain_platform ingest --sources vault,files,mail --mail-limit 200 --file-limit 3000 && /opt/ava-knowledge/venv/bin/python -m brain_platform embed-backfill --limit 800 && /opt/ava-knowledge/venv/bin/python -m brain_platform graph rebuild && /opt/ava-knowledge/venv/bin/python -m brain_platform sync-pg'
User=root
Nice=10

[Install]
WantedBy=multi-user.target
