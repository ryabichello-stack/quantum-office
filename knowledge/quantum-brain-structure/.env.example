# Second Brain / structure pack — env template (NO SECRETS IN GIT)

WEBHOOK_TOKEN=change-me

KNOWLEDGE_CONTENT_DIR=/opt/ava-knowledge/content
KNOWLEDGE_QUANTUM_LABS_PATH=/opt/ava-knowledge/content/quantum_labs.md
KNOWLEDGE_MAX_CHARS=4500

BRAIN_ENABLED=true
BRAIN_TENANT_ID=quantum-labs
BRAIN_DATA_DIR=/opt/ava-knowledge/data
BRAIN_DB_PATH=/opt/ava-knowledge/data/brain.db
BRAIN_ALLOW_LOCAL_INGEST=true
BRAIN_FILE_ROOTS=/opt/ava-knowledge/content

BRAIN_VAULT_PATH=/opt/ava-knowledge/vault/quantum-brain
BRAIN_GRAPH_IN_RETRIEVE=true
BRAIN_EVAL_MIN_PASS_RATE=0.7
BRAIN_DUAL_WRITE=true

# legacy until vault has real content; then brain
KNOWLEDGE_READ_MODE=legacy
BRAIN_VOICE_PRINCIPAL=service:voice-office

BRAIN_SEARCH_MODE=hybrid
BRAIN_STORE=postgres
BRAIN_VECTOR_BACKEND=pgvector
BRAIN_DATABASE_URL=postgresql://brain_app:CHANGE_ME@127.0.0.1:5433/quantum_brain
BRAIN_EMBED_PROVIDER=auto
BRAIN_EMBED_MODEL=text-embedding-3-small
BRAIN_EMBED_DIM=1536
BRAIN_EMBED_RESTRICTED_EXTERNAL=true
OPENAI_API_KEY=

# docker-compose postgres bootstrap
POSTGRES_PASSWORD=CHANGE_ME_SUPER
BRAIN_APP_PASSWORD=CHANGE_ME
POSTGRES_PORT=5433

MAIL_USERNAME=
MAIL_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
