# Second Brain / ava-knowledge

WEBHOOK_TOKEN=

# Content: bundled repo copy + live AVA md when present
KNOWLEDGE_CONTENT_DIR=/opt/ava-knowledge/content
KNOWLEDGE_QUANTUM_LABS_PATH=/root/ava/config/knowledge/quantum_labs.md
KNOWLEDGE_MAX_CHARS=4500

# Second Brain (additive /api/brain/* — legacy /api/knowledge/* unchanged)
BRAIN_ENABLED=true
BRAIN_TENANT_ID=quantum-labs
BRAIN_DATA_DIR=/opt/ava-knowledge/data
BRAIN_DB_PATH=/opt/ava-knowledge/data/brain.db
BRAIN_ALLOW_LOCAL_INGEST=true
BRAIN_FILE_ROOTS=/opt/ava-knowledge/content,/opt/ava-files/assets,/opt/ava-mailer/assets

# Mail ingest (same mailbox as outreach SMTP/IMAP when set)
MAIL_USERNAME=
MAIL_PASSWORD=
IMAP_HOST=imap.mail.ru
IMAP_PORT=993
BRAIN_IMAP_INBOX=INBOX
BRAIN_IMAP_SENT=Sent,Отправленные,INBOX.Sent
