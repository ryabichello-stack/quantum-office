WEBHOOK_TOKEN=change-me

# Yandex Telemost OAuth
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
YANDEX_OAUTH_REDIRECT_URI=https://a.47z.ru/_ava_conference/oauth/yandex/callback
YANDEX_OAUTH_SCOPE=telemost-api:conferences.create telemost-api:conferences.read
YANDEX_OAUTH_TOKEN_FILE=/opt/ava-conference/yandex_oauth_tokens.json
# Optional static token (dev): YANDEX_TELEMOST_OAUTH_TOKEN=

TELEMOST_ENABLED=true
TELEMOST_WAITING_ROOM_LEVEL=PUBLIC
TELEMOST_API_URL=https://cloud-api.yandex.net/v1/telemost-api/conferences
TELEMOST_TIMEOUT_SECONDS=6

# SMTP for invite emails (same mailbox as office is fine)
MAIL_SMTP_HOST=smtp.mail.ru
MAIL_SMTP_PORT=465
MAIL_USERNAME=office@quantumlabs.ru
MAIL_PASSWORD=
MAIL_FROM_NAME=Quantum Labs
CONFERENCE_REPLY_TO=office@quantumlabs.ru
