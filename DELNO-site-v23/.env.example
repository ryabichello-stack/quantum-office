# Голосовая демонстрация. Без ключа сайт работает, но озвучивание недоступно.
OPENAI_API_KEY=

# Заявки → delno-api (приоритет). Fallback: LEAD_WEBHOOK_URL или Telegram.
DELNO_API_URL=http://127.0.0.1:18020
DELNO_TENANT_SLUG=delno-demo
NEXT_PUBLIC_DELNO_API_URL=

# Widget (Crystal v28) — site proxy → delno-api /v1/public/widget/message
NEXT_PUBLIC_DELNO_WIDGET_SITE_KEY=demo_dlno

# Fallback если DELNO_API_URL пуст:
LEAD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
