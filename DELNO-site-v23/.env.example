# Голосовая демонстрация. Без ключа сайт работает, но озвучивание недоступно.
OPENAI_API_KEY=
# Тот же голос, что в телефонии AVA (openai_realtime → cedar)
DELNO_TTS_VOICE=cedar

# Заявки → delno-api (приоритет). Fallback: LEAD_WEBHOOK_URL или Telegram.
DELNO_API_URL=http://127.0.0.1:18020
DELNO_TENANT_SLUG=delno-demo
NEXT_PUBLIC_DELNO_API_URL=

# Widget (Crystal v28) — site proxy → delno-api /v1/public/widget/message
NEXT_PUBLIC_DELNO_WIDGET_SITE_KEY=demo_dlno

# SEO (prod: https://dlno.ru)
NEXT_PUBLIC_SITE_URL=https://dlno.ru
# Meta yandex-verification из API Вебmaster после bootstrap
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Яндекс.Метрика (счётчик на dlno.ru). Задаётся при деплое или через mailer /yandex/metrika/ensure.
YM_COUNTER_ID=
NEXT_PUBLIC_YM_COUNTER_ID=

# Fallback если DELNO_API_URL пуст:
LEAD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
