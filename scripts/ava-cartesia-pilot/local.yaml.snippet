# Snippet merged into /root/ava/config/ai-agent.local.yaml (pilot)
# Engaged sales-style Cartesia STT+TTS pilot — emotional delivery, tighter context.

contexts:
  cartesia_pilot:
    profile: telephony_ulaw_8k
    pipeline: hybrid_cartesia
    greeting: Привет! Денис на связи, Quantum Labs. Рад вас слышать — чем могу помочь?
    prompt: |
      Ты — Денис, живой телефонный продажник Quantum Labs. Русский. Говори тепло, заинтересованно, с энергией.
      Тон: вовлечённый продажник, не робот. Пиши живо: восклицания, тепло, интерес («отлично!», «понял вас!», «супер»). Без монотонных канцелярских фраз.
      Отвечай коротко: обычно 1 предложение, максимум 2. Без списков.
      ГЛАВНОЕ — держи нить: отвечай именно на последнюю реплику человека и на контекст разговора.
      Если реплика обрывок, шум или неясна — одной фразой переспроси, не выдумывай новую тему.
      Не уходи в сторону из одного странного слова. Не повторяй одно и то же.
      Базы знаний/скрипта пока нет: не выдумывай цены, тарифы и факты о продуктах Quantum Labs.
      Можно болтать и продавать интерес: уточняй потребность, предлагай следующий шаг разговора.
      Не отказывай от обычной болтовни. Если прощаются — тепло и кратко попрощайся.
    tools: []

providers:
  cartesia_tts:
    type: cartesia
    enabled: true
    capabilities:
      - tts
      - stt
    api_key: ${CARTESIA_API_KEY}
    voice_id: ${CARTESIA_VOICE_ID:-631151e9-7ae9-4324-b8e7-c72cb52e6cb1}
    model_id: ${CARTESIA_MODEL_ID:-sonic-3.6}
    language: ru
    base_url: https://api.cartesia.ai
    api_version: "2026-08-14"
    pcm_sample_rate: 16000
    tts_transport: websocket
    tts_speed: 1.12
    tts_volume: 1.25
    stt_model: ink-whisper
    stt_max_silence_secs: 0.7
    stt_min_volume: 0.035

pipelines:
  hybrid_cartesia:
    stt: cartesia_stt
    llm: openai_llm
    tts: cartesia_tts
    options:
      stt:
        streaming: true
        model: ink-whisper
        language: ru
        encoding: pcm_s16le
        sample_rate: 16000
        chunk_ms: 160
        max_silence_duration_secs: 0.7
        min_volume: 0.035
      llm:
        base_url: https://api.openai.com/v1
        model: gpt-4o-mini
        temperature: 0.75
        max_tokens: 90
        aggregation_timeout_sec: 0.35
      tts:
        language: ru
        transport: websocket
        speed: 1.12
        volume: 1.25
        format:
          encoding: mulaw
          sample_rate: 8000
