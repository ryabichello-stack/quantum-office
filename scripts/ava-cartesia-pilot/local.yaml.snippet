# Snippet merged into /root/ava/config/ai-agent.local.yaml (pilot)
# Free-talk Cartesia TTS pilot — no knowledge base / no in-call tools yet.

contexts:
  cartesia_pilot:
    profile: telephony_ulaw_8k
    pipeline: hybrid_cartesia
    greeting: Привет! Это Денис, пилот голоса Quantum Labs. О чём поговорим?
    prompt: |
      Ты — Денис, живой собеседник по телефону. Русский. Можно болтать на любую тему — шутки, еда, пиво, спорт, быт, что угодно безопасное.
      Не отказывай от болтовни («не могу помочь» запрещено для обычных тем). Это свободный разговор, не служба поддержки.
      Компании, скрипта и базы знаний пока нет — не выдумывай факты о Quantum Labs и не уводи в продажи.
      Говори коротко и естественно, обычно 1 предложение, максимум 2. Без списков и канцелярита.
      Держи нить разговора: отвечай именно на последнюю реплику человека, не уходи в сторону.
      Если шум или не расслышал — одной фразой переспроси. Не повторяй одно и то же.
      Календарь и tools в этом пилоте отключены — не обещай запись встреч.
      Если абонент прощается — попрощайся кратко.
    tools: []

providers:
  cartesia_tts:
    type: cartesia
    enabled: true
    capabilities:
      - tts
    api_key: ${CARTESIA_API_KEY}
    voice_id: ${CARTESIA_VOICE_ID:-631151e9-7ae9-4324-b8e7-c72cb52e6cb1}
    model_id: ${CARTESIA_MODEL_ID:-sonic-3.6}
    language: ru
    base_url: https://api.cartesia.ai
    api_version: "2026-08-14"
    pcm_sample_rate: 16000

pipelines:
  hybrid_cartesia:
    # local vosk STT on this host is broken → OpenAI REST STT
    stt: openai_stt
    llm: openai_llm
    tts: cartesia_tts
    options:
      stt:
        # REST STT: larger chunks = fewer mid-phrase cuts (latency tradeoff)
        model: gpt-4o-mini-transcribe
        language: ru
        chunk_ms: 2800
        streaming: false
      llm:
        base_url: https://api.openai.com/v1
        model: gpt-4o-mini
        temperature: 0.7
        max_tokens: 120
        aggregation_timeout_sec: 1.1
      tts:
        language: ru
        base_url: https://api.cartesia.ai
        format:
          encoding: mulaw
          sample_rate: 8000

# Global streaming (merge under existing `streaming:` / `barge_in:`)
# streaming:
#   pipeline_streaming_overlap: true
#   # NEVER enable filler with Cartesia overlap — race deafens mid-call STT
#   pipeline_filler_enabled: false
# barge_in:
#   pipeline_talk_detect_enabled: false
#   greeting_protection_ms: 6000
#   post_tts_end_protection_ms: 800
