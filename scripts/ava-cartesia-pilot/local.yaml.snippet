# Snippet merged into /root/ava/config/ai-agent.local.yaml (pilot)
# Sales energy without the "не расслышал" loop. RU emotion tags N/A.

contexts:
  cartesia_pilot:
    profile: telephony_ulaw_8k
    pipeline: hybrid_cartesia
    greeting: Привет! Денис, Quantum Labs — рад вас слышать! Чем могу помочь?
    prompt: |
      Ты — Денис, телефонный продажник Quantum Labs. Говори по-русски, как живой человек на звонке.

      ЭНЕРГИЯ:
      - Вовлечённый продажник: тепло, интерес, лёгкий драйв. Не секретарь и не энциклопедия.
      - Короткие живые фразы с восклицаниями и вопросом к собеседнику.
      - Примеры: «Ого, понял вас!» / «Супер, давайте разберёмся!» / «Звучит интересно — расскажите чуть подробнее?»

      ПОНИМАНИЕ (важно):
      - Распознавание речи бывает с ошибками. НЕ зацикливайся на «не расслышал».
      - По смыслу и контексту угадывай, о чём речь, и отвечай по делу. Переспрашивай только если совсем пусто/тишина.
      - Запрещено повторять одну и ту же фразу «Не расслышал / повторите» подряд.
      - Держи нить разговора; не меняй тему сам.

      ПРОДУКТ (кратко, без цифр):
      Quantum Labs — массовые выплаты физлицам на карты и через СБП, API и веб-кабинет.
      Если про деньги/заработок/выплаты — веди к этому. Цены и тонкие факты не выдумывай.

      ФОРМАТ: 1 предложение, максимум 2. Без списков. Болтовня ок. Прощание — тепло и коротко.
    tools: []

providers:
  cartesia_tts:
    type: cartesia
    enabled: true
    capabilities:
      - tts
      - stt
    api_key: ${CARTESIA_API_KEY}
    voice_id: ${CARTESIA_VOICE_ID:-631151e9-7ae9-4324-b8e7-c72cb52e6cb1}
    model_id: ${CARTESIA_MODEL_ID:-sonic-3.6}
    language: ru
    base_url: https://api.cartesia.ai
    api_version: "2026-08-14"
    pcm_sample_rate: 16000
    tts_transport: websocket
    tts_speed: 1.15
    tts_volume: 1.3
    stt_model: ink-whisper
    stt_max_silence_secs: 0.65
    stt_min_volume: 0.03

pipelines:
  hybrid_cartesia:
    stt: cartesia_stt
    llm: openai_llm
    tts: cartesia_tts
    options:
      stt:
        streaming: true
        model: ink-whisper
        language: ru
        encoding: pcm_s16le
        sample_rate: 16000
        chunk_ms: 160
        max_silence_duration_secs: 0.65
        min_volume: 0.03
      llm:
        base_url: https://api.openai.com/v1
        model: gpt-4o-mini
        temperature: 0.7
        max_tokens: 80
        aggregation_timeout_sec: 0.3
      tts:
        language: ru
        transport: websocket
        speed: 1.15
        volume: 1.3
        format:
          encoding: mulaw
          sample_rate: 8000
