[Unit]
Description=Quantum Labs Sheets Campaign (Google Sheet → AVA outbound)
After=network.target quantum-console.service

[Service]
Type=simple
WorkingDirectory=/opt/ava-sheets-campaign
EnvironmentFile=-/opt/ava-sheets-campaign/.env
ExecStart=/opt/ava-sheets-campaign/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8018
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
