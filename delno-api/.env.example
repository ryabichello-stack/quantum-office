# Database
DATABASE_URL=postgresql+psycopg://delno:delno@localhost:5433/delno

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=10080

# Default tenant for unauthenticated demo (slug)
DEFAULT_TENANT_SLUG=delno-demo

# Optional API key for tenant resolution (X-Api-Key header)
# API_KEY=

# delno-knowledge (Second Brain fork) — empty = isolated mode
KNOWLEDGE_BASE_URL=http://127.0.0.1:18021
KNOWLEDGE_USE_LEGACY_PRINCIPALS=true

# Model provider: openai | stub
MODEL_PROVIDER=openai

# External messengers — leave empty for isolation
MESSENGER_BASE_URL=

# Lead notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Operator
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Seed users (dev): owner@delno.one / demo123456, admin@delno.one / admin123456

# DaData party enrichment (E1.12) — reuse keys from /opt/ava-outreach/.env on prod
DADATA_API_KEY=
DADATA_SECRET_KEY=

# Widget rate limits (Commit 2) — per site_key + client IP per minute
WIDGET_RATE_LIMIT_PER_MINUTE=60
WIDGET_RATE_LIMIT_MESSAGES_PER_MINUTE=30
WIDGET_RATE_LIMIT_WINDOW_SEC=60

# CORS — comma-separated origins; empty = *.dlno.ru regex in main.py
# CORS_ALLOW_ORIGINS=https://app.dlno.ru,https://cdn.dlno.ru
CORS_ALLOW_CREDENTIALS=false
