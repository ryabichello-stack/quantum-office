# DELNO /opt/delno/.env — fill on server (mode 600). NEVER commit real values.

# --- Postgres (compose) ---
DELNO_PG_USER=delno
DELNO_PG_PASSWORD=change-me
DELNO_PG_DB=delno
DATABASE_URL=postgresql+psycopg://delno:change-me@postgres:5432/delno

# --- Auth ---
JWT_SECRET=change-me-long-random
JWT_EXPIRE_MINUTES=10080
DEFAULT_TENANT_SLUG=quantum-labs
DELNO_TENANT_SLUG=delno-demo
# Public site lead email notify (from Beget lead-email.env)
# LEAD_NOTIFY_TO=
# LEAD_SMTP_HOST=smtp.mail.ru
# LEAD_SMTP_PORT=465
# LEAD_SMTP_USER=
# LEAD_SMTP_PASSWORD=
# LEAD_SMTP_FROM=

# --- Public URLs (Cloud4Box / dlno.ru) ---
API_PUBLIC_BASE_URL=https://api.dlno.ru
PUBLIC_API_BASE=https://api.dlno.ru
PUBLIC_CDN_BASE=https://cdn.dlno.ru
DELNO_API_URL=http://api:8020
NEXT_PUBLIC_DELNO_API_URL=https://api.dlno.ru
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_DELNO_WIDGET_SITE_KEY=
CORS_ALLOW_ORIGINS=https://app.dlno.ru,https://dlno.ru,https://admin.dlno.ru,https://cdn.dlno.ru
CORS_ALLOW_CREDENTIALS=false

# --- Internal brokers ---
KNOWLEDGE_BASE_URL=http://knowledge:8021
KNOWLEDGE_USE_LEGACY_PRINCIPALS=true
FILES_BASE_URL=http://files:8015
MAILER_BASE_URL=http://mail:8000
CALENDAR_BASE_URL=http://calendar:8014
CONFERENCE_BASE_URL=http://conference:8016
MESSENGER_BASE_URL=
OFFICE_WEBHOOK_TOKEN=
TELEPHONY_WEBHOOK_TOKEN=

# --- OpenAI (egress via local proxy on C4B if geo-blocked) ---
MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_HTTP_PROXY=http://172.18.0.1:10808
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,postgres,knowledge,mail,calendar,files,conference,api,web

# --- Widget ---
WIDGET_RATE_LIMIT_PER_MINUTE=60
WIDGET_RATE_LIMIT_MESSAGES_PER_MINUTE=30
WIDGET_RATE_LIMIT_WINDOW_SEC=60

# --- DaData ---
DADATA_API_KEY=
DADATA_SECRET_KEY=

# --- Mail ---
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=DELNO

# --- Calendar / conference / files tokens (optional per connector) ---
CALENDAR_DEFAULT_SOURCE=mailru
CALENDAR_TIMEZONE=Europe/Moscow
MAILRU_CALDAV_URL=https://calendar.mail.ru
MAILRU_CALDAV_USERNAME=
MAILRU_CALDAV_PASSWORD=
MAILRU_CALENDAR_URL=
YANDEX_CALDAV_URL=https://caldav.yandex.ru
YANDEX_CALDAV_USERNAME=
YANDEX_CALDAV_PASSWORD=
YANDEX_CALENDAR_URL=
GOOGLE_CALENDAR_TOKEN=
GOOGLE_CALENDAR_ID=primary
OUTLOOK_CALENDAR_TOKEN=
OUTLOOK_CALENDAR_ID=
YANDEX_OAUTH_CLIENT_ID=
YANDEX_OAUTH_CLIENT_SECRET=
YANDEX_OAUTH_ACCESS_TOKEN=
YANDEX_TELEMOST_OAUTH_TOKEN=
TELEMOST_STUB_WHEN_UNAUTH=true
CONFERENCE_DEFAULT_PROVIDER=yandex
CONFERENCE_STUB_WHEN_UNAUTH=true
TELEMOST_ENABLED=true
JITSI_ENABLED=true
JITSI_BASE_URL=https://meet.jit.si
GOOGLE_MEET_TOKEN=
ZOOM_ACCESS_TOKEN=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
TEAMS_TOKEN=
MICROSOFT_GRAPH_TOKEN=
YADISK_TOKEN=
MAILRU_WEBDAV_URL=https://webdav.cloud.mail.ru
MAILRU_WEBDAV_USER=
MAILRU_WEBDAV_PASSWORD=
GOOGLE_DRIVE_TOKEN=
ONEDRIVE_TOKEN=
ONEDRIVE_DRIVE_ROOT=me/drive
FILES_MAX_BYTES=47185920

# --- Alerts / channels ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- TTS (site demos) ---
DELNO_TTS_VOICE=cedar
